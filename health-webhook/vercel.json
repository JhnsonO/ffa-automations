{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "functions": {
    "api/*.js": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/wellknown?doc=prm" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/wellknown?doc=prm" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/wellknown?doc=as" },
    { "source": "/.well-known/openid-configuration", "destination": "/api/wellknown?doc=as" },
    { "source": "/oauth/register", "destination": "/api/oauth?op=register" },
    { "source": "/oauth/authorize", "destination": "/api/oauth?op=authorize" },
    { "source": "/oauth/token", "destination": "/api/oauth?op=token" }
  ]
}
